[
  {
    "method": "POST",
    "path": "/instance/create",
    "title": "/instance/create",
    "params": [
      {
        "name": "instanceName",
        "type": "string",
        "required": true,
        "description": "Identificador único da instância dentro da sua conta. Será usado como :name em todos os outros endpoints."
      },
      {
        "name": "qrcode",
        "type": "boolean",
        "required": false,
        "description": "Retorna o QR Code na resposta de criação (se suportado pelo core)."
      },
      {
        "name": "token",
        "type": "string",
        "required": false,
        "description": "Token personalizado."
      },
      {
        "name": "rejectCall",
        "type": "boolean",
        "required": false,
        "description": "Rejeita automaticamente chamadas recebidas."
      },
      {
        "name": "msgCall",
        "type": "string",
        "required": false,
        "description": "Mensagem enviada automaticamente ao rejeitar uma chamada."
      },
      {
        "name": "groupsIgnore",
        "type": "boolean",
        "required": false,
        "description": "Ignora eventos de grupos no webhook."
      },
      {
        "name": "alwaysOnline",
        "type": "boolean",
        "required": false,
        "description": "Mantém a conta sempre online no WhatsApp."
      },
      {
        "name": "readMessages",
        "type": "boolean",
        "required": false,
        "description": "Marca automaticamente as mensagens como lidas."
      },
      {
        "name": "readStatus",
        "type": "boolean",
        "required": false,
        "description": "Marca automaticamente status como visto."
      },
      {
        "name": "syncFullHistory",
        "type": "boolean",
        "required": false,
        "description": "Sincroniza o histórico completo do WhatsApp ao conectar."
      },
      {
        "name": "webhook.enabled",
        "type": "boolean",
        "required": false,
        "description": "Ativa o webhook já na criação."
      },
      {
        "name": "webhook.url",
        "type": "string",
        "required": false,
        "description": "URL HTTPS pública que receberá os eventos. Bloqueado: localhost, IPs privados e redes internas (proteção SSRF)."
      },
      {
        "name": "webhook.events",
        "type": "string[]",
        "required": false,
        "description": "Lista de eventos para filtrar. Se omitida, todos os eventos são enviados."
      },
      {
        "name": "webhook.base64",
        "type": "boolean",
        "required": false,
        "description": "Se true, mídias nos eventos vêm codificadas em base64."
      },
      {
        "name": "proxyHost",
        "type": "string",
        "required": false,
        "description": "Proxy: host público (Enterprise)."
      },
      {
        "name": "proxyPort",
        "type": "string",
        "required": false,
        "description": "Proxy: porta (Enterprise)."
      },
      {
        "name": "proxyUsername",
        "type": "string",
        "required": false,
        "description": "Proxy: usuário (Enterprise)."
      },
      {
        "name": "proxyPassword",
        "type": "string",
        "required": false,
        "description": "Proxy: senha (Enterprise)."
      },
      {
        "name": "migration",
        "type": "object",
        "required": false,
        "description": "Migração de sessão Baileys já autenticada. Restrito ao plano Enterprise. Estrutura: { creds: object, preKeys: array }. Resposta inclui migration: { jid, preKeysImported, connected }."
      },
      {
        "name": "proxyProtocol",
        "type": "string",
        "required": false,
        "description": "http | https | socks5 (Enterprise)."
      }
    ]
  },
